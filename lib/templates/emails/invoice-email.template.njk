<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Facture {{ invoice.invoiceNumber }}</title>

  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
      color: #333;
      line-height: 1.6;
      margin: 0;
      padding: 20px;
      background: white;
    }
    .container {
      max-width: 900px;
      margin: 0 auto;
      border: 1px solid #e5e7eb;
      padding: 40px;
    }
    header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 40px;
      border-bottom: 2px solid #f59e0b;
      padding-bottom: 20px;
    }
    .company-info h1 {
      margin: 0;
      color: #d97706;
      font-size: 28px;
    }
    .company-info p {
      margin: 5px 0;
      color: #666;
      font-size: 12px;
    }
    .invoice-details {
      text-align: right;
    }
    .invoice-details p {
      margin: 5px 0;
      font-size: 12px;
    }
    .invoice-number {
      font-size: 24px;
      font-weight: bold;
      color: #d97706;
      margin: 10px 0;
    }
    .invoice-status {
      display: inline-block;
      padding: 5px 10px;
      background: #dcfce7;
      color: #166534;
      border-radius: 4px;
      font-size: 12px;
      font-weight: bold;
    }
    .client-info {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 40px;
      margin: 30px 0;
      padding: 20px 0;
    }
    .client-info h3 {
      margin: 0 0 10px 0;
      font-size: 12px;
      font-weight: bold;
      color: #666;
    }
    .client-info p {
      margin: 3px 0;
      font-size: 12px;
    }
    .items-table {
      width: 100%;
      border-collapse: collapse;
      margin: 30px 0;
    }
    .items-table thead {
      background: #f3f4f6;
      border-top: 2px solid #e5e7eb;
      border-bottom: 2px solid #e5e7eb;
    }
    .items-table th {
      padding: 12px;
      text-align: left;
      font-weight: 600;
      font-size: 12px;
      color: #374151;
    }
    .items-table td {
      padding: 12px;
      border-bottom: 1px solid #e5e7eb;
      font-size: 12px;
    }
    .items-table tbody tr:hover {
      background: #f9fafb;
    }
    .text-right {
      text-align: right;
    }
    .totals {
      display: flex;
      justify-content: flex-end;
      margin: 30px 0;
    }
    .totals-box {
      width: 300px;
    }
    .total-row {
      display: flex;
      justify-content: space-between;
      padding: 8px 0;
      border-bottom: 1px solid #e5e7eb;
      font-size: 12px;
    }
    .total-row.total {
      border-top: 2px solid #d97706;
      border-bottom: 2px solid #d97706;
      margin-top: 10px;
      padding: 12px 0;
      font-weight: bold;
      font-size: 14px;
    }
    .notes {
      margin: 30px 0;
      padding: 20px;
      background: #f9fafb;
      border-left: 4px solid #d97706;
      font-size: 12px;
    }
    .footer {
      margin-top: 40px;
      padding-top: 20px;
      border-top: 1px solid #e5e7eb;
      text-align: center;
      font-size: 10px;
      color: #999;
    }
    @media print {
      body { padding: 0; }
      .container { border: none; box-shadow: none; }
    }
  </style>
</head>

<body>
  <div class="container">
    <header>
      <div class="company-info">
        <h1>{{ companyInfo.name }}</h1>
        <p>{{ companyInfo.address }}</p>
        <p>{{ companyInfo.city }}</p>
        <p>Tél: {{ companyInfo.phone }}</p>
        <p>Email: {{ companyInfo.email }}</p>
        <p>SIRET: {{ companyInfo.siret }}</p>
      </div>

      <div class="invoice-details">
        <div class="invoice-number">{{ invoice.invoiceNumber }}</div>
        <div class="invoice-status">FACTURE</div>
        <p><strong>Date d'émission:</strong> {{ issueDateFormatted }}</p>
        <p><strong>Échéance:</strong> {{ dueDateFormatted }}</p>
      </div>
    </header>

    <div class="client-info">
      <div>
        <h3>FACTURÉ À:</h3>
        <p>{{ invoice.items[0].productName | default("Client") }}</p>
        <p style="margin-top: 15px;">Merci pour votre achat</p>
      </div>
    </div>

    <table class="items-table">
      <thead>
        <tr>
          <th>Désignation</th>
          <th class="text-right">Quantité</th>
          <th class="text-right">Prix unitaire</th>
          <th class="text-right">TVA</th>
          <th class="text-right">Montant</th>
        </tr>
      </thead>
      <tbody>
        {% for item in invoice.items %}
        <tr>
          <td>{{ item.productName }}</td>
          <td class="text-right">{{ item.quantity }}</td>
          <td class="text-right">{{ item.unitPrice | round(2) }}€</td>
          <td class="text-right">{{ (item.taxRate * 100) | round }}%</td>
          <td class="text-right">{{ item.subtotal | round(2) }}€</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>

    <div class="totals">
      <div class="totals-box">
        <div class="total-row">
          <span>Sous-total:</span>
          <span>{{ subtotal | round(2) }}€</span>
        </div>
        <div class="total-row">
          <span>TVA (20%):</span>
          <span>{{ taxAmount | round(2) }}€</span>
        </div>
        <div class="total-row total">
          <span>TOTAL:</span>
          <span>{{ total | round(2) }}€</span>
        </div>
      </div>
    </div>

    {% if invoice.notes %}
      <div class="notes">
        <strong>Notes:</strong> {{ invoice.notes }}
      </div>
    {% endif %}

    <div class="footer">
      <p>Conditions de paiement: {{ invoice.paymentTerms | default("Net 30") }}</p>
      <p>Merci d'avoir choisi TAT GLOBAL</p>
    </div>
  </div>
</body>
</html>